# User-level template: merge these settings into ~/.codex/config.toml.
# Keep the safe workspace profile as the user-level default. The project-local
# .codex/config.toml selects the Docker profile only for this repository.
default_permissions = ":workspace"

[permissions.workspace-docker]
description = "Workspace access with Docker Desktop"
extends = ":workspace"

[permissions.workspace-docker.network]
enabled = true

[permissions.workspace-docker.network.domains]
"ghcr.io" = "allow"
"pkg-containers.githubusercontent.com" = "allow"
"mcr.microsoft.com" = "allow"

[permissions.workspace-docker.network.unix_sockets]
"/var/run/docker.sock" = "allow"
