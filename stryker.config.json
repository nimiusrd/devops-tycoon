{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": true
  },
  "mutate": [
    "src/sim/**/*.ts",
    "src/state/**/*.ts",
    "!src/sim/**/types.ts",
    "!src/sim/**/index.ts",
    "!src/state/**/types.ts",
    "!src/state/**/index.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts"
  ],
  "ignorePatterns": [
    "reports",
    ".stryker-tmp",
    "dist",
    "gallery",
    "coverage",
    "playwright-report",
    "test-results"
  ],
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 10000,
  "disableBail": false
}
